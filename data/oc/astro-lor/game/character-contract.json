  "table_schemas": {
    "chara_base": {
      "format": "T2B",
      "lists": ["CHARA_BASE_BATTLE_LIST_BEG", "CHARA_BASE_INFO_LIST_BEG"],
      "node": "CHARA_BASE_INFO",
      "fields": {
        "0": "charaId",
        "1": "internalCode",
        "3": "nameHash",
        "4": "lastNameHash",
        "11": "gender",
        "15": "seriesId",
        "16": "belongTeamId",
        "19": "descriptionHash"
      },
      "join_rule": "charaId is the base identity; internalCode is the c-prefixed VFS code"
    },
    "chara_param": {
      "format": "T2B",
      "lists": ["CHARA_PARAM_INFO_LIST_BEG"],
      "node": "CHARA_PARAM_INFO",
      "fields": {
        "0": "charaParamId",
        "1": "charaBaseId",
        "2": "element",
        "3": "mainPosition",
        "4": "subPosition",
        "8": "growthPattern",
        "10+2*n": "skillLearnLevel",
        "11+2*n": "skillId"
      },
      "skill_slots": 9,
      "join_rule": "charaBaseId must resolve to chara_base.charaId"
    },
    "chara_name_tag": {
      "format": "RDBN",
      "lists": ["m_charaNameTagConfigList"],
      "list": "m_charaNameTagConfigList",
      "fields": ["tagId", "charaId", "overloadNameId"]
    },
    "chara_scale": {
      "format": "RDBN",
      "lists": ["m_charaScaleList"],
      "list": "m_charaScaleList",
      "fields": ["charaID", "field", "soccer", "menu", "menuLooksFirst", "follower", "offset", "addchara", "addchara_offset_y", "rpgBattle", "charaSize", "menuLooksVS", "addchara_offset_y_for_vs"]
    },
    "chara_model": {
      "format": "T2B",
      "lists": ["CHARA_MODEL_BASE_PATH_LIST_BEG", "CHARA_MODEL_INFO_LIST_BEG", "CHARA_BODY_INFO_LIST_BEG"],
      "node": "CHARA_MODEL_INFO",
      "body_node": "CHARA_BODY_INFO",
      "join_rule": "CHARA_MODEL_INFO.var[10] resolves the face model; body and default clothing are resolved from the model/body fields"
    },
    "chara_parts": {
      "format": "T2B",
      "lists": [
        "CHARA_PARTS_COLOR_LIST_BEG",
        "CHARA_PARTS_CLOTHES_BASE_PATH_LIST_BEG",
        "CHARA_PARTS_CLOTHES_INFO_LIST_BEG",
        "CHARA_PARTS_CLOTHES_MODEL_LIST_BEG",
        "CHARA_PARTS_SHOES_BASE_PATH_LIST_BEG",
        "CHARA_PARTS_SHOES_INFO_LIST_BEG",
        "CHARA_PARTS_SHOES_MODEL_LIST_BEG",
        "CHARA_PARTS_GLOVE_BASE_PATH_LIST_BEG",
        "CHARA_PARTS_GLOVE_INFO_LIST_BEG",
        "CHARA_PARTS_GLOVE_MODEL_LIST_BEG",
        "CHARA_PARTS_EXMESH_BASE_PATH_LIST_BEG",
        "CHARA_PARTS_EXMESH_INFO_LIST_BEG",
        "CHARA_PARTS_EXMESH_MODEL_LIST_BEG"
      ],
      "node_prefixes": ["CHARA_PARTS_COLOR", "CHARA_PARTS_CLOTHES_", "CHARA_PARTS_SHOES_", "CHARA_PARTS_GLOVE_", "CHARA_PARTS_EXMESH_"],
      "join_rule": "model CRCs resolve into the clothes, shoes and glove model/info lists; paths are relative to common/chr"
    },
    "chara_motion": {
      "format": "T2B",
      "lists": ["CHARA_MOTION_BASE_PATH_LIST_BEG", "CHARA_MOTION_INFO_LIST_BEG", "CHARA_MOTION_PRESET_DATA_LIST_BEG", "CHARA_MOTION_PRESET_INFO_LIST_BEG"],
      "node_prefixes": ["CHARA_MOTION_INFO", "CHARA_MOTION_PRESET_DATA", "CHARA_MOTION_PRESET_INFO"],
      "join_rule": "motion rows select versioned g4pk paths and preset data; they are shared by character model rows"
    },
    "chara_face": {
      "format": "T2B",
      "lists": ["CHARA_FACIAL_DATA_LIST_BEG", "CHARA_FACIAL_MOTION_INFO_LIST_BEG", "CHARA_FACIAL_LIPSYNC_DATA_LIST_BEG", "FACIAL_MOT_GROUP_LIST_BEG", "CHARA_FACIAL_PRECEDE_DATA_LIST_BEG"],
      "node_prefixes": ["CHARA_FACIAL_DATA", "CHARA_FACIAL_MOTION_INFO", "CHARA_FACIAL_LIPSYNC_DATA", "FACIAL_MOT_GROUP", "CHARA_FACIAL_PRECEDE_DATA"],
      "join_rule": "facial rows are keyed by character facial resources and motion/lipsync groups; no row is assigned until the target cfg.bin is patched"
    },
    "chara_costume": {
      "format": "T2B",
      "lists": ["CHARA_COSTUME_MODEL_LIST_BEG", "CHARA_COSTUME_DATA_LIST_BEG", "CHARA_COSTUME_INFO_LIST_BEG"],
      "node": "CHARA_COSTUME_MODEL",
      "join_rule": "costume model IDs resolve the character's available costume entries; shared clothing geometry remains in chara_parts"
    }
