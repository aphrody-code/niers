<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-target for maximum compatibility -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);SYSLIB1225</NoWarn>
    <!-- Copie toutes les dépendances NuGet dans le dossier de sortie, pour que
         node-api-dotnet (bun:ffi/Bun) résolve l'assembly + ses deps depuis un
         seul dossier. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- ═══════════════════════════════════════════════════════════════════════════
       Consolidated Libraries (previously external projects)
       CfgBinEditor, CriFsV2Lib, Viola, SaveEditor now integrated
       ═══════════════════════════════════════════════════════════════════════════ -->

  <!-- ═══════════════════════════════════════════════════════════════════════════
       NuGet Packages
       ═══════════════════════════════════════════════════════════════════════════ -->
  <ItemGroup>
    <PackageReference Include="MoonSharp" Version="2.0.0" />
    <PackageReference Include="SharpGLTF.Toolkit" Version="1.0.5" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.1" />
    <PackageReference Include="CommunityToolkit.HighPerformance" Version="8.4.0" />
    
    <!-- Texture Compression -->
    <PackageReference Include="BCnEncoder.Net" Version="2.2.1" />

    <!-- Compression -->
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />

    <!-- Database -->
    <!-- 10.0.11 et non 10.0.0 : la 10.0.0 tirait SQLitePCLRaw 2.1.11, porteur de
         GHSA-2m69-gcr7-jv3q (gravité élevée), signalé à chaque build par NU1903. Montée de
         patch dans la même majeure/mineure ; l'absence de NU1903 est vérifiée par un restore,
         pas supposée. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />

    <!-- Steam content delivery (download natif des depots, remplace steamcmd) -->
    <PackageReference Include="SteamKit2" Version="3.4.0" />
  </ItemGroup>

  <!-- Expose les types internes (ex. SteamTokenStore) au projet de tests. -->
  <ItemGroup>
    <InternalsVisibleTo Include="IECODE.Core.Tests" />
  </ItemGroup>

  <!-- ═══════════════════════════════════════════════════════════════════════════
       Embedded Resources
       ═══════════════════════════════════════════════════════════════════════════ -->
  <ItemGroup>
    <EmbeddedResource Include="Resources/EACLauncher.zip" />
  </ItemGroup>

</Project>
