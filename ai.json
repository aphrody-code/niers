{
  "name": "niers",
  "version": "1.0.0",
  "spec": "a2a/v1.0",
  "id": "niers@aphrody-code/niers",
  "schema_version": "1.0.0",
  "kind": "agent",
  "description": "Pure Rust native implementation and byte-exact reverse engineering of Inazuma Eleven: Victory Road. Multi-agent coordination via JSONL mailboxes and local JSON-RPC listener.",
  "a2a_protocol_version": "1.0",
  "documentation_url": "https://github.com/aphrody-code/aphrody/blob/main/docs/a2a/README.md",
  "provider": {
    "organization": "aphrody-code",
    "url": "https://github.com/aphrody-code/aphrody"
  },
  "supported_interfaces": [
    {
      "url": "http://127.0.0.1:8792",
      "protocol_binding": "JSONRPC",
      "protocol_version": "1.0"
    }
  ],
  "capabilities": {
    "streaming": true,
    "pushNotifications": false,
    "extendedAgentCard": true
  },
  "default_input_modes": [
    "text/plain",
    "application/json"
  ],
  "default_output_modes": [
    "text/plain",
    "application/json"
  ],
  "skills": [
    {
      "id": "vfs-browse",
      "name": "VFS Browser",
      "description": "Enumerate and extract assets from the 255,308 files across 936 CPKs"
    },
    {
      "id": "forge-build",
      "name": "Forge Rebuilder",
      "description": "Reassemble byte-identical nie.exe binary (74.00% coverage, 92.24% .text)"
    },
    {
      "id": "lua-audit",
      "name": "Lua Runtime Validator",
      "description": "Validate and audit 1,197 Lua 5.2 bytecode chunks"
    }
  ],
  "peers": [
    {
      "id": "claude@aphrody-code/niers",
      "role": "orchestrator",
      "transport": "claude-code",
      "binary": "claude",
      "invocation": "claude -p <prompt> --output-format text",
      "description": "Claude Code orchestrator."
    },
    {
      "id": "codex@aphrody-code/niers",
      "role": "subagent",
      "transport": "cli",
      "binary": "codex",
      "invocation": "codex exec --cd /home/ubuntu/niers --skip-git-repo-check <prompt>",
      "description": "Codex CLI non-interactive executor."
    },
    {
      "id": "astra@aphrody-code/niers",
      "role": "verifier",
      "transport": "cli",
      "binary": "agy",
      "invocation": "agy -p <prompt>",
      "description": "Astra (Antigravity CLI / Gemini). Autonomous verifier and lead agent."
    }
  ],
  "coordination": {
    "channel_dir": ".coord",
    "mailboxes": {
      "claude@aphrody-code/niers": ".coord/inbox-from-claude.jsonl",
      "codex@aphrody-code/niers": ".coord/inbox-from-codex.jsonl",
      "astra@aphrody-code/niers": ".coord/inbox-from-astra.jsonl"
    },
    "heartbeats": {
      "claude@aphrody-code/niers": ".coord/heartbeat-claude.txt",
      "codex@aphrody-code/niers": ".coord/heartbeat-codex.txt",
      "astra@aphrody-code/niers": ".coord/heartbeat-astra.txt"
    },
    "protocol": "docs/A2A-CODEX.md"
  }
}
