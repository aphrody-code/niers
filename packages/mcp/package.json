{
	"name": "@rosegriffon/mcp",
	"version": "1.0.0",
	"description": "Serveur MCP du monorepo Rose Griffon \u2014 impl\u00e9mentation Bun native (z\u00e9ro d\u00e9pendance Node) de la r\u00e9vision 2026-07-28 et des r\u00e9visions \u00e0 handshake, exposant les donn\u00e9es Azal\u00e9e/IEVR et l'\u00e9tat du monorepo",
	"type": "module",
	"license": "MIT",
	"bin": {
		"rg-mcp": "./src/cli.ts"
	},
	"exports": {
		".": "./src/index.ts",
		"./protocol": "./src/protocol/index.ts",
		"./registry": "./src/registry.ts",
		"./server": "./src/server.ts",
		"./transport/http": "./src/transport/http.ts",
		"./transport/stdio": "./src/transport/stdio.ts",
		"./package.json": "./package.json"
	},
	"files": [
		"src",
		"context",
		"README.md"
	],
	"scripts": {
		"start": "bun src/cli.ts serve --http",
		"stdio": "bun src/cli.ts serve --stdio",
		"test": "bun test test",
		"lint": "oxlint --config ../../.oxlintrc.json src test",
		"type-check": "bun --bun tsc --noEmit",
		"typecheck": "bun --bun tsc --noEmit"
	},
	"dependencies": {
		"@niers/azalee-tools": "workspace:*",
		"@rosegriffon/azalee": "workspace:*",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@rosegriffon/config": "workspace:*",
		"@types/bun": "catalog:",
		"oxlint": "catalog:",
		"typescript": "catalog:"
	},
	"engines": {
		"bun": ">=1.2.0"
	},
	"keywords": [
		"mcp",
		"model-context-protocol",
		"bun",
		"rose-griffon",
		"azalee"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	}
}
