{
  "env": {
    "NIERS_REPO": "/home/ubuntu/niers",
    "BASH_ENV": "/home/ubuntu/niers/.claude/shell-init.sh",
    "NIE_GAME_DIR": "/home/ubuntu/niers"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/etat.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/garde-bash.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "niers-marketplace": {
      "source": {
        "source": "directory",
        "path": "./plugins"
      }
    }
  },
  "enabledPlugins": {
    "niers@niers-marketplace": true,
    "frontend-design@claude-plugins-official": true
  }
}
